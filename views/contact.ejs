<% title = "Contact Us"; %>
<% content = `
<h2>Contact Us</h2>
<p>Have any questions, feedback, or inquiries? We’d love to hear from you! Fill out the form below, and we’ll get back to you as soon as possible. Whether you need more info on gym techniques, soccer drills, or nutrition, we’re here to help.</p> <p>Your feedback is important to us as we continue to improve and provide the best experience for our community. Feel free to reach out with any comments or requests!</p>

<form action="/submit-contact" method="POST">
    <label for="name">Your Name:</label>
    <input type="text" id="name" name="name" required><br><br>

    <label for="email">Your Email:</label>
    <input type="email" id="email" name="email" required><br><br>

    <label for="message">Your Message:</label>
    <textarea id="message" name="message" rows="4" cols="50" required></textarea><br><br>

    <button type="submit">Submit</button>
</form>

<img src="/images/contact.jpg" alt="Gym and Soccer" style="width:100%; height:auto; border-radius:10px; margin-top:20px;">

` %>
<%- include('layout') %>

